{
  "extends": "@spancle/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "outDir":            "./dist",
    "rootDir":           "./src",
    "declaration":       true,
    "declarationMap":    true,
    "sourceMap":         true,
    "noEmit":            false,
    "module":            "commonjs",
    "moduleResolution":  "node",
    "jsx":               "react-jsx",
    "lib":               ["ES2022", "DOM", "DOM.Iterable"],
    "noUnusedLocals":    false,
    "noUnusedParameters": false,
    "skipLibCheck":      true
  },
  "include":  ["src/**/*"],
  "exclude":  ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts", "**/*.stories.tsx"]
}
