{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit":            false,
    "noEmitOnError":     false,
    "declaration":       false,
    "declarationMap":    false,
    "sourceMap":         true,
    "removeComments":    true,
    "incremental":       false
  },
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.e2e-spec.ts"
  ]
}
