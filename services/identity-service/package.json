    "@nestjs/testing": "^10.3.10",
    "@spancle/tsconfig": "workspace:*",
    "@spancle/eslint-config": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "rimraf": "^5.0.7",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typescript": "*",
    "@types/bcryptjs": "^2.4.6"
