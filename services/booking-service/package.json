{
  "name": "@spancle/booking-service",
  "version": "0.1.0",
  "private": true,
  "description": "Spancle Sports OS — Facility bookings, time slot management and venue coordination",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern=spec",
    "test:e2e": "jest --config jest-e2e.config.js",
    "test:coverage": "jest --coverage",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nestjs/axios": "^3.0.2",
    "@nestjs/bull": "^10.2.1",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/typeorm": "^10.0.2",
    "@spancle/event-contracts": "workspace:^",
    "@spancle/types": "workspace:*",
    "axios": "^1.7.2",
    "bullmq": "^5.12.12",
    "cache-manager": "^5.7.6",
    "cache-manager-ioredis": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^16",
    "tslib": "^2.6.3",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.3.10",
    "@spancle/eslint-config": "workspace:*",
    "@spancle/tsconfig": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "jest": "^29.7.0",
    "rimraf": "^5.0.7",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typescript": "*"
  }
}
