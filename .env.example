# =============================================================================
# SPANCLE SPORTS OS — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env for local development.
# NEVER commit .env files. This file is safe to commit.
# All secrets must be provisioned via secret manager in non-local environments.
# =============================================================================

# --- NODE ---
NODE_ENV=development
LOG_LEVEL=debug

# --- APPLICATION ---
APP_NAME=spancle-sports-os
APP_VERSION=0.1.0
APP_PORT=3000

# --- MULTI-TENANCY ---
# Header used to resolve tenant context on every inbound request
TENANT_HEADER=x-tenant-id
# Tenant subdomain resolution strategy: header | subdomain | path
TENANT_RESOLUTION_STRATEGY=header

# --- POSTGRESQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=spancle
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=spancle_dev
# Full DSN — constructed from above in non-local envs
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# Connection pool
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
# SSL (always true in production)
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- REDIS ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_TLS=false
# Full URL — constructed from above in non-local envs
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}
# Redis DB indices (namespaced per concern)
REDIS_DB_CACHE=0
REDIS_DB_SESSION=1
REDIS_DB_QUEUE=2
REDIS_DB_PUBSUB=3

# --- JWT / AUTH ---
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=spancle-sports-os
# Rotation: set to previous secret during key rotation window
JWT_SECRET_PREVIOUS=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# --- RATE LIMITING ---
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_TENANT_OVERRIDE=false

# --- ENCRYPTION ---
# 32-byte hex string for AES-256 field-level encryption of PII
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_STRING
# Key version identifier for rotation support
ENCRYPTION_KEY_VERSION=v1

# --- AUDIT ---
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DRIVER=database
# Options: database | elasticsearch | file
AUDIT_LOG_RETENTION_DAYS=365

# --- EMAIL ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@spancle.io

# --- STORAGE ---
STORAGE_DRIVER=local
# Options: local | s3 | gcs
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- MONITORING ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- FEATURE FLAGS ---
FEATURE_FLAG_DRIVER=env
# Options: env | launchdarkly | flagsmith
LAUNCHDARKLY_SDK_KEY=

# --- API GATEWAY ---
API_GATEWAY_PORT=4000
API_GATEWAY_TIMEOUT_MS=30000
API_GATEWAY_MAX_PAYLOAD_SIZE=10mb

# --- SERVICES (internal) ---
AUTH_SERVICE_URL=http://localhost:3001
TENANT_SERVICE_URL=http://localhost:3002
PLAYER_SERVICE_URL=http://localhost:3003
ANALYTICS_SERVICE_URL=http://localhost:3004
BILLING_SERVICE_URL=http://localhost:3005
NOTIFICATION_SERVICE_URL=http://localhost:3006
