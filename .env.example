# =============================================================================
# SPANCLE SPORTS OS — Environment Variable Template
# =============================================================================
# Copy to .env for local development:
#   cp .env.example .env
#
# For production, set these via your secret manager or /etc/spancle/.env.production
# NEVER commit a file containing real secrets.
# =============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=warn
NEXT_TELEMETRY_DISABLED=1

# ── Multi-tenancy ─────────────────────────────────────────────────────────────
TENANT_HEADER=x-tenant-id
TENANT_RESOLUTION_STRATEGY=header

# ── PostgreSQL — one DATABASE_URL per service ─────────────────────────────────
# Each service reads DATABASE_URL from its own environment.
# Replace <password> with your actual database password.
DATABASE_URL=postgresql://spancle:<password>@127.0.0.1:5432/spancle_identity
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@127.0.0.1:6379
REDIS_TLS=false
REDIS_DB_CACHE=0
REDIS_DB_SESSION=1
REDIS_DB_QUEUE=2
REDIS_DB_PUBSUB=3

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=replace_with_minimum_32_char_secret
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=spancle-sports-os
JWT_SECRET_PREVIOUS=

# ── NextAuth (Next.js apps) ───────────────────────────────────────────────────
# Generate: openssl rand -base64 48
NEXTAUTH_SECRET=replace_with_minimum_32_char_secret
NEXTAUTH_URL=https://app.example.com

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_char_hex_string
ENCRYPTION_KEY_VERSION=v1

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://example.com,https://app.example.com,https://admin.example.com
CORS_CREDENTIALS=true

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Internal service URLs (loopback) ──────────────────────────────────────────
IDENTITY_SERVICE_URL=http://127.0.0.1:4001
SAAS_PLATFORM_SERVICE_URL=http://127.0.0.1:4002
BOOKING_SERVICE_URL=http://127.0.0.1:4003
FINANCE_SERVICE_URL=http://127.0.0.1:4004
TOURNAMENT_SERVICE_URL=http://127.0.0.1:4005
ACADEMY_SERVICE_URL=http://127.0.0.1:4006
COMMUNICATION_SERVICE_URL=http://127.0.0.1:4007
REPORTING_SERVICE_URL=http://127.0.0.1:4008

# ── Next.js public API URLs (browser → nginx) ─────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_BOOKING_URL=https://api.example.com
NEXT_PUBLIC_IDENTITY_URL=https://api.example.com
NEXT_PUBLIC_REPORTING_URL=https://api.example.com
NEXT_PUBLIC_SAAS_URL=https://api.example.com
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_BASE_DOMAIN=example.com

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Spancle Sports OS

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/var/spancle/uploads
# S3 (uncomment to use)
# STORAGE_DRIVER=s3
# S3_BUCKET=your-bucket-name
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=replace_with_access_key
# S3_SECRET_ACCESS_KEY=replace_with_secret_key

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── Audit ─────────────────────────────────────────────────────────────────────
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DRIVER=database
AUDIT_LOG_RETENTION_DAYS=365
