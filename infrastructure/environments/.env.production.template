# =============================================================================
# SPANCLE SPORTS OS — Production Environment Variables
# /etc/spancle/.env.production
#
# This file is the MASTER template for single-server production deployment.
# It is loaded by PM2 ecosystem.production.config.js via env_file.
# All 8 NestJS services and 4 Next.js apps read from this file.
#
# SETUP:
#   sudo mkdir -p /etc/spancle
#   sudo cp infrastructure/environments/.env.production.template /etc/spancle/.env.production
#   sudo nano /etc/spancle/.env.production         # fill in all CHANGE_ME values
#   sudo chmod 600 /etc/spancle/.env.production
#   sudo chown deploy:deploy /etc/spancle/.env.production
#
# SECURITY:
#   - Never commit this file to version control.
#   - Only the deploy user (and root) should have read access.
#   - Rotate JWT_SECRET and NEXTAUTH_SECRET independently.
#   - Use strong random values: openssl rand -base64 48
# =============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=warn
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1

# ── Multi-tenancy ─────────────────────────────────────────────────────────────
TENANT_HEADER=x-tenant-id
TENANT_RESOLUTION_STRATEGY=header

# ── PostgreSQL — Identity Service ─────────────────────────────────────────────
# Database: spancle_identity
# Stores: tenants, users, roles, identities, branches, courts, sports
IDENTITY_DATABASE_URL=postgresql://spancle:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/spancle_identity

# ── PostgreSQL — SaaS Platform Service ───────────────────────────────────────
# Database: spancle_saas
# Stores: packages, plans, subscriptions, CMS pages, blog, media
SAAS_DATABASE_URL=postgresql://spancle:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/spancle_saas

# ── PostgreSQL — Booking Service ──────────────────────────────────────────────
# Database: spancle_booking
# Stores: bookings, slots, pricing rules, QR tokens, venues
BOOKING_DATABASE_URL=postgresql://spancle:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/spancle_booking

# ── PostgreSQL — Finance Service ──────────────────────────────────────────────
# Database: spancle_finance
# Stores: invoices, payments, refunds, wallets, reconciliation logs
FINANCE_DATABASE_URL=postgresql://spancle:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/spancle_finance

# ── PostgreSQL — Tournament Service ──────────────────────────────────────────
# Database: spancle_tournament
TOURNAMENT_DATABASE_URL=postgresql://spancle:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/spancle_tournament

# ── PostgreSQL — Academy Service ─────────────────────────────────────────────
# Database: spancle_academy
ACADEMY_DATABASE_URL=postgresql://spancle:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/spancle_academy

# ── PostgreSQL — Communication Service ───────────────────────────────────────
# Database: spancle_communication
COMMUNICATION_DATABASE_URL=postgresql://spancle:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/spancle_communication

# ── PostgreSQL — Reporting Service ───────────────────────────────────────────
# Database: spancle_reporting
REPORTING_DATABASE_URL=postgresql://spancle:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/spancle_reporting

# ── PostgreSQL — Shared connection pool defaults ──────────────────────────────
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ── Redis ─────────────────────────────────────────────────────────────────────
# Single Redis instance, multiple DB indices per concern
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379
REDIS_TLS=false
REDIS_DB_CACHE=0
REDIS_DB_SESSION=1
REDIS_DB_QUEUE=2
REDIS_DB_PUBSUB=3

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=spancle-sports-os
# Previous secret — set during key rotation window, then clear
JWT_SECRET_PREVIOUS=

# ── NextAuth.js (Next.js apps) ────────────────────────────────────────────────
# Generate: openssl rand -base64 48
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET_MIN_32_CHARS
# Each app gets its own NEXTAUTH_URL — overridden per PM2 process
NEXTAUTH_URL=https://app.spancle.io

# ── Encryption ────────────────────────────────────────────────────────────────
# 32-byte hex string for AES-256 field-level encryption
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_STRING
ENCRYPTION_KEY_VERSION=v1

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://spancle.com,https://www.spancle.com,https://manage.spancle.com,https://api.spancle.com
CORS_CREDENTIALS=true

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_TENANT_OVERRIDE=false

# ── Internal service URLs (loopback — all on same server) ─────────────────────
IDENTITY_SERVICE_URL=http://127.0.0.1:3001
SAAS_PLATFORM_SERVICE_URL=http://127.0.0.1:3002
BOOKING_SERVICE_URL=http://127.0.0.1:3003
FINANCE_SERVICE_URL=http://127.0.0.1:3004
TOURNAMENT_SERVICE_URL=http://127.0.0.1:3005
ACADEMY_SERVICE_URL=http://127.0.0.1:3006
COMMUNICATION_SERVICE_URL=http://127.0.0.1:3007
REPORTING_SERVICE_URL=http://127.0.0.1:3008

# ── Next.js public API URLs (browser → nginx → services) ─────────────────────
NEXT_PUBLIC_API_URL=https://api.spancle.io
NEXT_PUBLIC_BOOKING_URL=https://api.spancle.io
NEXT_PUBLIC_IDENTITY_URL=https://api.spancle.io
NEXT_PUBLIC_REPORTING_URL=https://api.spancle.io
NEXT_PUBLIC_SAAS_URL=https://api.spancle.io
NEXT_PUBLIC_SITE_URL=https://spancle.io
NEXT_PUBLIC_BASE_DOMAIN=spancle.io

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=noreply@spancle.io
SMTP_FROM_NAME=Spancle Sports OS

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/var/spancle/uploads
# S3 (uncomment when switching to S3)
# STORAGE_DRIVER=s3
# S3_BUCKET=spancle-production-media
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=CHANGE_ME
# S3_SECRET_ACCESS_KEY=CHANGE_ME
# S3_ENDPOINT=

# ── Monitoring / Observability ────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── Audit ─────────────────────────────────────────────────────────────────────
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DRIVER=database
AUDIT_LOG_RETENTION_DAYS=365

# ── Feature flags ─────────────────────────────────────────────────────────────
FEATURE_FLAG_DRIVER=env

# ── Seed databases (only used by seed scripts, not application) ───────────────
# All services share a single DB user. Per-service DBs are in DATABASE_URL below.
# Seed script reads IDENTITY_DB_URL, BOOKING_DB_URL, FINANCE_DB_URL directly.
IDENTITY_DB_URL=postgresql://spancle:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/spancle_identity
BOOKING_DB_URL=postgresql://spancle:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/spancle_booking
FINANCE_DB_URL=postgresql://spancle:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/spancle_finance
