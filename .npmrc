# Spancle Sports OS — pnpm configuration
# Strict mode: prevents phantom dependencies and undeclared imports

# Strict peer dependency resolution
strict-peer-dependencies=false
auto-install-peers=true

# Hoisting: only hoist packages explicitly listed — prevents phantom deps
# hoist-pattern is intentionally permissive at root but locked at package level
hoist=true
hoist-pattern[]=*eslint*
hoist-pattern[]=*prettier*
hoist-pattern[]=*typescript*
hoist-pattern[]=*jest*
hoist-pattern[]=*turbo*
hoist-pattern[]=*husky*
hoist-pattern[]=*commitlint*
hoist-pattern[]=*lint-staged*

# Public hoist: hoist type declarations and all internal workspace packages globally
public-hoist-pattern[]=*types*
public-hoist-pattern[]=@types/*
public-hoist-pattern[]=@spancle/*

# Lockfile: always use lockfile for reproducible installs
use-lockfile=true
lockfile=true

# Registry
registry=https://registry.npmjs.org/

# Shell autocomplete
# shell-emulator=true

# Store
# store-dir=~/.pnpm-store

# Dedupe on install
dedupe-peer-dependents=true
